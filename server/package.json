    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.9"
