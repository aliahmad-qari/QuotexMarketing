# Environment Variables for Candle Probability Lab

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (Optional: fallback in-memory cache active if unset)
MONGODB_URI=

# Market Data Streams (Binance Spot Public Market Data)
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Prediction Model Version
PREDICTION_MODEL_VERSION=indicator-v1

# Frontend Public Config (for standalone Next.js deployment if separated)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Platform
GEMINI_API_KEY=
APP_URL=

